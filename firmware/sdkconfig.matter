# Matter builds only (product and GATE_DEMO). The GATE_SIM build leaves this file out, so these keys do
# not reach it. Most values follow the air quality sensor project (../toggle-gate/firmware/sdkconfig.defaults).

# BLE is used only to add the device to Apple Home
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Matter over Wi-Fi only
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_ESP_MATTER_ENABLE_OPENTHREAD=n
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# No firmware update over the network in this version (spec, "Out of scope of stage 1")
CONFIG_ENABLE_OTA_REQUESTOR=n

# Test VID 0xFFF1, PID 0x8000 and the test DAC are the defaults of DEVICE_VENDOR_ID, DEVICE_PRODUCT_ID and
# ESP_MATTER_DAC_PROVIDER; written out so a change of the defaults does not pass unnoticed.
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8000
CONFIG_EXAMPLE_DAC_PROVIDER=y

# Setup passcode and discriminator of each unit come from its units/<unit>.defaults (main/setup_code.cpp)
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y

# Root node and the gate
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2

# Release logging, as in sdkconfig.defaults
CONFIG_CHIP_LOG_DEFAULT_LEVEL_EQUALS_LOG_DEFAULT_LEVEL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y

# The task watchdog does not watch the IDLE tasks: Matter commissioning crypto can keep IDLE from running
# for over 1 s on the ESP32-C6, and the 1 s panic timeout would then reset the chip. The gate task keeps
# its own 1 s subscription (relay_out_watch_this_task). CPU1 is in sdkconfig.matter.esp32s3.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Free flash: the app must fit one 1.92 MB slot of the XIAO ESP32-C6 (partitions.csv)
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ENABLE_WIFI_TELEMETRY=n
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_CHIP_CONFIG_IM_PRETTY_PRINT=n
CONFIG_LWIP_DHCPS=n

# Matter clusters of the gate endpoint: Closure Control by default. sdkconfig.window-covering and
# sdkconfig.door-lock switch to the other candidate types.
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=y
CONFIG_SUPPORT_WINDOW_COVERING_CLUSTER=n
CONFIG_SUPPORT_DOOR_LOCK_CLUSTER=n

# Matter clusters this device does not use. BINDING and SCENES stay because the SDK links against them.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AMBIENT_CONTEXT_SENSING_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
